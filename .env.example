# =============================================================================
# Credit Risk Intelligence Platform - environment configuration
# Copy to `.env` and fill in. `docker compose up` reads this file.
#   cp .env.example .env
# =============================================================================

# -- LLM: Google Gemini -------------------------------------------------------
# Required for the "Ask the data" chatbot and the plain-English explanation text.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Two models, deliberately split by job. The SQL model does the hard structured
# reasoning; the cheaper model only turns already-computed rows into a sentence.
# See docs/PROMPTS.md for the measured token/cost effect of this split.
#
# Pinned to stable IDs rather than floating `-latest` aliases so an evaluator
# reproduces the documented results. If your key's tier cannot reach these, the
# client walks a documented fallback chain at startup and logs what it picked.
GEMINI_MODEL_SQL=gemini-3.7-flash
GEMINI_MODEL_SUMMARY=gemini-3.5-flash-lite

# -- Dataset acquisition ------------------------------------------------------
# Home Credit Default Risk is a Kaggle *competition* dataset, so you must accept
# its rules once at:
#   https://www.kaggle.com/competitions/home-credit-default-risk/rules
# The Kaggle v2 SDK authenticates with a single token from
# https://www.kaggle.com/settings/api  ("Generate New Token").
# Leave blank if you download the ZIP by hand into ./data - see README.
KAGGLE_API_TOKEN=

# -- Ingestion ----------------------------------------------------------------
# When true, the API builds the database itself in a background thread if it
# starts and finds none. Leave false for docker-compose (which runs a dedicated
# `etl` service for this - having both do it would race two concurrent builds).
# Set true only on single-service platforms like Render, where there is no
# companion container to run the ETL. See render.yaml and docs/DEPLOYMENT.md.
AUTO_INGEST_ON_STARTUP=false

# -- Data mode ----------------------------------------------------------------
# full : ingest all 7 Kaggle tables (~55M rows). Needs ~8 GB disk, >=2 GB RAM.
# lite : ingest a stratified sample. Fits a 512 MB instance; numbers are sampled.
DATA_MODE=full

# -- Storage paths (container-internal; override only if you relocate volumes) -
DATA_DIR=/app/data
DUCKDB_PATH=/app/data/credit_risk.duckdb
MODELS_DIR=/app/models

# DuckDB will spill to disk rather than exceed this. Set to roughly 60% of the
# instance RAM: 1GB on a 2 GB Render instance, 8GB on a 16 GB laptop.
DUCKDB_MEMORY_LIMIT=8GB
DUCKDB_THREADS=4

# -- Talk-to-data guardrails --------------------------------------------------
# Hard ceiling injected into every generated query, and the wall-clock budget
# a single question is allowed to consume.
MAX_SQL_ROWS=500
SQL_TIMEOUT_SECONDS=30
# Rows actually forwarded to the summarising model (token control, not display).
MAX_SUMMARY_ROWS=50

# -- API service --------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
